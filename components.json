{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@magicui": "https://magicui.design/r/{name}.json",
    "@supabase": "https://supabase.com/ui/r/{name}.json",
    "@ai-elements": "https://registry.ai-sdk.dev/{name}.json",
    "@bundui": "https://bundui.io/api/registry/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@nusaiba": "https://nusaiba.dev/r/base-nova/{name}.json"
  }
}
